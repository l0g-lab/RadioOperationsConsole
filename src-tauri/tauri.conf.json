{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Radio Operations Console",
  "version": "2.3.0",
  "identifier": "org.radiooperationsconsole.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Radio Operations Console",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https://tile.openstreetmap.org https://radar.weather.gov",
        "connect-src": "'self' ipc: http://ipc.localhost https://tile.openstreetmap.org",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https://tile.openstreetmap.org https://radar.weather.gov",
        "connect-src": "'self' ipc: http://ipc.localhost https://tile.openstreetmap.org ws://localhost:1420",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "l0g-lab",
    "copyright": "Copyright © 2026 l0g-lab. Licensed under the GPL-3.0-or-later.",
    "license": "GPL-3.0-or-later",
    "homepage": "https://github.com/l0g-lab/RadioOperationsConsole",
    "category": "Utility",
    "shortDescription": "Offline-first logging for amateur-radio nets, emcomm and SKYWARN",
    "longDescription": "Radio Operations Console is an offline-first desktop app for running amateur-radio nets, emergency communications activations, exercises and SKYWARN operations: rapid check-ins, traffic, spotter reports, range checks, a repeater directory and net listings, maps, NWS alerts and radar, and ICS-309/213 forms for Winlink.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
